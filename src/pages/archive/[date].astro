---
import Base from '../../layouts/Base.astro';
import { config } from '../../../config/site.config';
import { loadIndex, loadDay } from '../../lib/data';
import { dayMain, type ViewCtx } from '../../lib/views';
import { formatDay } from '../../lib/format';

export async function getStaticPaths() {
  const { data } = await loadIndex();
  return data.days.map((d) => ({ params: { date: d.date } }));
}
const { date } = Astro.params;
const day = await loadDay(date as string);
const v: ViewCtx = {
  now: new Date(), siteName: config.site.name, tagline: config.site.tagline, categories: config.categories,
  publishTimesIST: config.schedule.publishTimesIST, contactEmail: config.site.contactEmail,
};
const main = dayMain(date as string, day.data?.clusters ?? [], v);
---
<Base main={main} title={formatDay(date as string)} description={`Stories from ${formatDay(date as string)}.`} activeNav="archive" generatedAt={day.data?.generatedAt ?? null} />
