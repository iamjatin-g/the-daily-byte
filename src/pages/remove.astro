---
import Base from '../layouts/Base.astro';
import { config } from '../../config/site.config';
import { removeMain } from '../lib/pages';
import { loadRemovedDomains } from '../lib/data';
import type { ViewCtx } from '../lib/views';

const v: ViewCtx = {
  now: new Date(), siteName: config.site.name, tagline: config.site.tagline, categories: config.categories,
  publishTimesIST: config.schedule.publishTimesIST, contactEmail: config.site.contactEmail,
};
const main = removeMain(v, await loadRemovedDomains());
---
<Base main={main} title="Publisher removal requests" description="How publishers can ask to be removed from this site." />
