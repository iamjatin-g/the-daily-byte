---
import Base from '../../layouts/Base.astro';
import { config } from '../../../config/site.config';
import { loadLatest } from '../../lib/data';
import { categoryMain, type ViewCtx } from '../../lib/views';
import { categoryLabel } from '../../lib/format';

export function getStaticPaths() {
  return config.categories.map((c) => ({ params: { id: c.id } }));
}
const { id } = Astro.params;
const { data, ok } = await loadLatest();
const v: ViewCtx = {
  now: new Date(), siteName: config.site.name, tagline: config.site.tagline, categories: config.categories,
  publishTimesIST: config.schedule.publishTimesIST, contactEmail: config.site.contactEmail,
};
const label = categoryLabel(id as string, config.categories);
const main = categoryMain(id as string, { latest: data.latest, ok }, v);
---
<Base main={main} title={label} description={`Latest ${label} stories from ${config.site.name}.`} activeNav={id as string} generatedAt={ok ? data.generatedAt : null} />
