---
import Base from '../layouts/Base.astro';
import { config } from '../../config/site.config';
import { loadLatest } from '../lib/data';
import { homeMain, type ViewCtx } from '../lib/views';

const { data, ok } = await loadLatest();
const v: ViewCtx = {
  now: new Date(), siteName: config.site.name, tagline: config.site.tagline, categories: config.categories,
  publishTimesIST: config.schedule.publishTimesIST, contactEmail: config.site.contactEmail,
};
const main = homeMain({ lead: data.lead, featured: data.featured, latest: data.latest, ok }, v);
---
<Base main={main} isHome activeNav="all" generatedAt={ok ? data.generatedAt : null} />
