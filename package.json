{
  "name": "news-autopilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-search.ts",
    "preview": "astro preview",
    "worker": "tsx worker/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "astro": "4.16.18",
    "@astrojs/tailwind": "5.1.4",
    "@astrojs/sitemap": "3.2.1",
    "tailwindcss": "3.4.17",
    "zod": "3.24.1",
    "rss-parser": "3.13.0",
    "cheerio": "1.0.0",
    "pagefind": "1.3.0"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "@astrojs/check": "0.9.4",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "eslint": "9.17.0",
    "typescript-eslint": "8.18.2",
    "prettier": "3.4.2",
    "prettier-plugin-astro": "0.14.1",
    "@types/node": "22.10.2"
  }
}
